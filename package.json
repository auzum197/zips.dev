{
  "name": "zipreader",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial explorer for the zcash/zips repository",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "next dev",
    "build": "pnpm sync && next build && pagefind --site out",
    "start": "pnpm dlx serve out",
    "typecheck": "tsc --noEmit",
    "audit:apca": "node scripts/apca-audit.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@shikijs/rehype": "^1.24.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hast-util-from-html": "^2.0.3",
    "js-yaml": "^4.1.0",
    "next": "^15.1.0",
    "postcss": "^8.5.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "shiki": "^1.24.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "temml": "^0.14.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hast-util-to-html": "^9.0.6",
    "pagefind": "^1.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0"
  }
}
