{
  "name": "zipreader",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial explorer for the zcash/zips repository",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "tsx scripts/sync.mts",
    "dev": "next dev",
    "build": "pnpm sync && pnpm og && next build && pagefind --site out",
    "start": "pnpm dlx serve out",
    "typecheck": "tsc --noEmit",
    "audit:apca": "tsx scripts/apca-audit.mts",
    "og": "tsx scripts/og.mts",
    "og:preview": "tsx scripts/og-preview.mts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@shikijs/rehype": "^1.24.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hast-util-from-html": "^2.0.3",
    "js-yaml": "^4.1.0",
    "next": "^15.1.0",
    "postcss": "^8.5.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "shiki": "^1.24.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "temml": "^0.14.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/nextjs": "^10.6.6",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "hast-util-to-html": "^9.0.6",
    "pagefind": "^1.3.0",
    "playwright-core": "^1.64.1",
    "satori": "^0.63.2",
    "storybook": "^10.6.6",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
        "postcss": "^8.5.31",
        "fflate": "^0.7.5"
    },
    "auditConfig": {
        "ignoreGhsas": [
            "GHSA-848j-6mx2-7j84",
            "GHSA-g84c-rxfj-3j2c",
            "GHSA-238p-pmpm-9mq7",
            "GHSA-gcqx-w48m-w2h4"
        ]
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver",
      "@parcel/watcher",
      "core-js"
    ]
  }
}
