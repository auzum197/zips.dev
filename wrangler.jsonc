{
  // zipreader.org — static export served by Cloudflare Workers Static Assets.
  // When the agent/auth backend lands, add "main": "src/worker.ts" + bind KV/D1 here;
  // the assets config stays and the Worker script handles non-asset routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zips-auzum197",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
